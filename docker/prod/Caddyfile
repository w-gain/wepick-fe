:80 {
    route {
        @health path /health
        respond @health "OK" 200

        root * /srv/frontend
        encode zstd gzip

        @assets {
            path /assets/*
            file
        }
        handle @assets {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }

        handle /assets/* {
            respond 404
        }

        handle {
            try_files {path} /index.html
            header Cache-Control "no-cache, no-store, must-revalidate"
            file_server
        }
    }
}
